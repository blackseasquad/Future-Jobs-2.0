# Копирай като .env и попълни. НИКОГА не качвай .env в Git.

PORT=3000
# Публичен адрес на приложението (използва се в имейлите)
PUBLIC_URL=http://localhost:3000
# Път до SQLite базата
DATABASE_PATH=./data/future-jobs.db

# Секрет за планирания endpoint POST /api/cron/refresh (поне 32 символа).
# Генерирай: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
# Токен за администраторския панел (ръчно обновяване). Различен от CRON_SECRET.
ADMIN_TOKEN=

# --- Vercel ---
# На Vercel: свържи private Blob store към проекта (BLOB_STORE_ID се добавя автоматично).
# Извън Vercel може да се ползва BLOB_READ_WRITE_TOKEN. Локално не е нужно.
# BLOB_DB_PATHNAME=future-jobs/db.sqlite
# REFRESH_BUDGET_MS=240000

# --- Опционални източници ---
# Adzuna (безплатни ключове: https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Държави за Adzuna (поддържани от Adzuna, напр. de,pl,gb,fr,nl,at)
ADZUNA_COUNTRIES=de,pl

# --- AI обяснения (опционално) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Имейл (SMTP) ---
# Пример за Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, парола за приложение
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Future Jobs <no-reply@example.com>"
